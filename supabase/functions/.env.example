# Supabase Edge Functions 시크릿 (예시). 실제 값은 `supabase secrets set` 으로만 등록한다.
# 이 파일에 실제 키를 넣지 않는다.

# Upstage — 앱에는 절대 넣지 않는다 (APK 디컴파일 시 유출)
UPSTAGE_API_KEY=up_xxxxxxxxxxxxxxxxxxxx

# 모델 문자열 — 코드에 박지 않고 여기서 주입 (콘솔에서 정확한 이름 확인)
SOLAR_MODEL=solar-pro3
EMBED_PASSAGE_MODEL=embedding-passage
EMBED_QUERY_MODEL=embedding-query

# Supabase 접속 (로컬 supabase functions serve 시 자동 주입되므로 배포 환경에서만 확인)
# SUPABASE_URL / SUPABASE_ANON_KEY 는 런타임에서 기본 제공된다.
